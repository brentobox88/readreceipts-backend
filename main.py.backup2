        }
    }

@app.get("/health")
async def health():
    return {
        "status": "healthy",
        "timestamp": datetime.now().isoformat(),
        "database": "connected",
        "ocr": "available",
        "storage": {
            "uploads": os.path.exists(UPLOAD_DIR),
            "exports": os.path.exists(EXPORT_DIR)
        }
    }

@app.post("/upload")
async def upload_receipt(
    file: UploadFile = File(...),
    business: str = None,
    background_tasks: BackgroundTasks = None,
    db: Session = Depends(get_db)
):
    """
    Upload and process a receipt image with AI OCR
    """
    try:
        # Validate file
        if not file.filename:
            raise HTTPException(status_code=400, detail="No filename provided")
        
        # Validate file type
        allowed_types = ['image/jpeg', 'image/png', 'image/jpg', 'image/heic']
        if file.content_type not in allowed_types:
            raise HTTPException(
                status_code=400, 
                detail=f"Unsupported file type. Allowed: {', '.join(allowed_types)}"
            )
        
        # Read file content
        content = await file.read()
        file_size = len(content)
        
        if file_size == 0:
            raise HTTPException(status_code=400, detail="Empty file")
        
        # Save file locally (for backup/reference)
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        safe_filename = f"{timestamp}_{file.filename.replace(' ', '_')}"
        filepath = os.path.join(UPLOAD_DIR, safe_filename)
        
        with open(filepath, "wb") as buffer:
            buffer.write(content)
        
        logger.info(f"Processing receipt: {file.filename} ({file_size} bytes)")
        
        # Process with REAL OCR
        try:
            result = await ocr_service.process_receipt(content, file.filename)
            logger.info(f"OCR result: {result.get('merchant_name', 'Unknown')} - ")
        except Exception as ocr_error:
            logger.error(f"OCR processing failed: {str(ocr_error)}")
            raise HTTPException(status_code=500, detail=f"OCR failed: {str(ocr_error)}")
        
        # Parse transaction date
        transaction_date = datetime.now()
        if result.get("transaction_date"):
            try:
                # Try various date formats
                for fmt in ["%Y-%m-%d", "%m/%d/%Y", "%d/%m/%Y", "%Y/%m/%d"]:
                    try:
                        transaction_date = datetime.strptime(result["transaction_date"], fmt)
                        break
                    except:
                        continue
            except:
                transaction_date = datetime.now()
        
        # Create receipt record with enhanced data
        receipt = Receipt(
            filename=file.filename,
            file_path=filepath,
            file_size=file_size,
            raw_text=result.get("raw_text", ""),
            parsed_data=result,
            
            # Merchant data
            merchant_name=result.get("merchant_name", ""),
            merchant_address=result.get("merchant_address", ""),
            
            # Transaction data
            transaction_date=transaction_date,
            receipt_number=result.get("receipt_number", ""),
            
            # Financial data
            subtotal=result.get("subtotal", 0.0),
            tax_amount=result.get("tax_amount", 0.0),
            tax_rate=result.get("tax_rate", 0.0),
            total_amount=result.get("total_amount", 0.0),
            currency=result.get("currency", "USD"),
            
            # Categorization
            category=result.get("category", "other"),
            business=business or result.get("business", "general"),
            tags=result.get("tags", []),
            line_items=result.get("line_items", []),
            notes=result.get("notes", ""),
            
            # Confidence score
            confidence_score=result.get("confidence", 0.0),
            
            # Status
            status="processed",
            processed_at=datetime.now(),
            manually_edited=False,
            is_exported=False
        )
        
        db.add(receipt)
        db.commit()
        db.refresh(receipt)
        
        # Log success
        logger.info(f"Receipt {receipt.id} processed successfully - {receipt.merchant_name}")
        
        return {
            "success": True,
            "message": "Receipt processed successfully",
            "receipt_id": receipt.id,
            "confidence_score": receipt.confidence_score,
            "data": {
                "id": receipt.id,
                "merchant": receipt.merchant_name,
                "total": f"{receipt.total_amount:.2f} {receipt.currency}",
                "tax": f"{receipt.tax_amount:.2f} {receipt.currency}",
                "category": receipt.category,
                "business": receipt.business,
                "notes": receipt.notes,
                "date": receipt.transaction_date.strftime("%Y-%m-%d"),
                "confidence": f"{receipt.confidence_score:.1%}",
                "line_items_count": len(receipt.line_items) if receipt.line_items else 0,
                "needs_review": receipt.confidence_score < 0.85
            }
        }
        
    except HTTPException as he:
        raise he
    except Exception as e:
        logger.error(f"Upload failed: {str(e)}", exc_info=True)
        raise HTTPException(status_code=500, detail=f"Upload failed: {str(e)}")

@app.get("/receipts")
async def get_receipts(
    business: str = None,
    category: str = None,
    min_confidence: float = None,
    db: Session = Depends(get_db)
):
    """
    Get all processed receipts with optional filters
    """
    query = db.query(Receipt).filter(Receipt.status == "processed")
    
    if business:
        query = query.filter(Receipt.business == business)
    
    if category:
        query = query.filter(Receipt.category == category)
    
    if min_confidence:
        query = query.filter(Receipt.confidence_score >= min_confidence)
    
    receipts = query.order_by(Receipt.transaction_date.desc()).all()
    
    return {
        "count": len(receipts),
        "filters": {
            "business": business,
            "category": category,
            "min_confidence": min_confidence
        },
        "receipts": [
            {
                "id": r.id,
                "merchant": r.merchant_name,
                "total": r.total_amount,
                "tax": r.tax_amount,
                "category": r.category,
                "business": r.business,
                "notes": r.notes,
                "date": r.transaction_date.strftime("%Y-%m-%d"),
                "status": r.status,
                "confidence": r.confidence_score,
                "needs_review": r.confidence_score < 0.85
            }
            for r in receipts
        ]
    }

@app.get("/receipts/{receipt_id}")
async def get_receipt(
    receipt_id: str,
    db: Session = Depends(get_db)
):
    """
    Get a single receipt by ID
    """
    receipt = db.query(Receipt).filter(Receipt.id == receipt_id).first()
    
    if not receipt:
        raise HTTPException(status_code=404, detail="Receipt not found")
    
    return {
        "id": receipt.id,
        "merchant": receipt.merchant_name,
        "merchant_address": receipt.merchant_address,
        "date": receipt.transaction_date.strftime("%Y-%m-%d"),
        "total": receipt.total_amount,
        "tax": receipt.tax_amount,
        "subtotal": receipt.subtotal,
        "currency": receipt.currency,
        "category": receipt.category,
        "business": receipt.business,
        "tags": receipt.tags,
        "notes": receipt.notes,
        "line_items": receipt.line_items,
        "confidence": receipt.confidence_score,
        "status": receipt.status,
        "filename": receipt.filename,
        "created_at": receipt.created_at.isoformat() if receipt.created_at else None,
        "processed_at": receipt.processed_at.isoformat() if receipt.processed_at else None
    }

@app.get("/export/excel")
async def export_to_excel(
    business: str = None,
    db: Session = Depends(get_db)
):
    """
    Export receipts to Excel spreadsheet
    """
    try:
        # Get receipts
        query = db.query(Receipt).filter(Receipt.status == "processed")
        if business:
            query = query.filter(Receipt.business == business)
        
        receipts = query.all()
        
        if not receipts:
            raise HTTPException(status_code=404, detail="No receipts to export")
        
        # Convert to dict format for exporter
        receipts_data = []
        for receipt in receipts:
            receipts_data.append({
                "merchant_name": receipt.merchant_name,
                "total_amount": receipt.total_amount,
                "tax_amount": receipt.tax_amount,
                "category": receipt.category,
                "business": receipt.business,
                "notes": receipt.notes,
                "transaction_date": receipt.transaction_date,
                "confidence": f"{receipt.confidence_score:.1%}"
            })
        
        # Export to Excel
        export_path = spreadsheet_exporter.export_to_excel(receipts_data)
        
        # Return the file
        filename = os.path.basename(export_path)
        return FileResponse(
            path=export_path,
            filename=filename,
            media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
        )
        
    except Exception as e:
        logger.error(f"Export failed: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Export failed: {str(e)}")

@app.get("/export/csv")
async def export_to_csv(
    business: str = None,
    db: Session = Depends(get_db)
):
    """
    Export receipts to CSV format
    """
    try:
        import pandas as pd
        from io import StringIO
        
        # Get receipts
        query = db.query(Receipt).filter(Receipt.status == "processed")
        if business:
            query = query.filter(Receipt.business == business)
        
        receipts = query.all()
        
        if not receipts:
            raise HTTPException(status_code=404, detail="No receipts to export")
        
        # Convert to DataFrame
        data = []
        for receipt in receipts:
            data.append({
                "Merchant": receipt.merchant_name,
                "Date": receipt.transaction_date.strftime("%Y-%m-%d"),
                "Total": receipt.total_amount,
                "Tax": receipt.tax_amount,
                "Category": receipt.category,
                "Business": receipt.business,
                "Notes": receipt.notes,
                "Confidence": f"{receipt.confidence_score:.1%}"
            })
        
        df = pd.DataFrame(data)
        
        # Generate CSV
        csv_buffer = StringIO()
        df.to_csv(csv_buffer, index=False)
        csv_content = csv_buffer.getvalue()
        
        # Save to file
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        filename = f"receipts_export_{timestamp}.csv"
        filepath = os.path.join(EXPORT_DIR, filename)
        
        with open(filepath, "w") as f:
            f.write(csv_content)
        
        return FileResponse(
            path=filepath,
            filename=filename,
            media_type="text/csv"
        )
        
    except Exception as e:
        logger.error(f"CSV export failed: {str(e)}")
        raise HTTPException(status_code=500, detail=f"CSV export failed: {str(e)}")

@app.get("/test/receipts")
async def test_receipts(db: Session = Depends(get_db)):
    """
    Create test receipts with realistic data (for development)
    """
    test_receipts = [
        {
            "filename": "lyft_receipt.jpg",
            "merchant_name": "Lyft",
            "total_amount": 22.74,
            "tax_amount": 2.62,
            "category": "transportation",
            "business": "production",
            "notes": "Lyft - production trip transportation expense",
            "confidence_score": 0.92
        },
        {
            "filename": "pizza_receipt.jpg",
            "merchant_name": "North of Brooklyn Pizzeria",
            "total_amount": 35.88,
            "tax_amount": 4.13,
            "category": "food",
            "business": "production",
            "notes": "Pizza - production trip food expense",
            "confidence_score": 0.88
        },
        {
            "filename": "apple_receipt.jpg",
            "merchant_name": "Apple",
            "total_amount": 14.68,
            "tax_amount": 1.69,
            "category": "software",
            "business": "general",
            "notes": "Apple - iCloud 2TB subscription",
            "confidence_score": 0.95
        },
        {
            "filename": "uber_receipt.jpg",
            "merchant_name": "Uber",
            "total_amount": 18.50,
            "tax_amount": 2.13,
            "category": "transportation",
            "business": "client_meeting",
            "notes": "Uber - client meeting transportation",
            "confidence_score": 0.90
        }
    ]
    
    created = []
    for test_data in test_receipts:
        receipt = Receipt(
            **test_data,
            file_path=f"uploads/test/{test_data['filename']}",
            status="processed",
            transaction_date=datetime.now(),
            processed_at=datetime.now(),
            currency="USD",
            subtotal=test_data["total_amount"] - test_data["tax_amount"],
            parsed_data=test_data
        )
        db.add(receipt)
        created.append(receipt)
    
    db.commit()
    
    return {
        "message": f"Created {len(test_receipts)} test receipts",
        "receipts": [
            {
                "id": r.id,
                "merchant": r.merchant_name,
                "total": r.total_amount,
                "category": r.category,
                "confidence": f"{r.confidence_score:.1%}"
            }
            for r in created
        ]
    }

